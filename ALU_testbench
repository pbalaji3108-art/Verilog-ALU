`timescale 1ns / 1ps   // time unit / precision

module alu_4bit_tb;

    // declare inputs as reg (we drive them)
    reg [3:0] A;
    reg [3:0] B;
  	reg [2:0] op;

    // declare outputs as wire (we just observe them)
    wire [3:0] result;
    wire zero;

    // connect testbench to ALU module
    alu_4bit uut (
        .A(A),
        .B(B),
        .op(op),
        .result(result),
        .zero(zero)
    );

    initial begin
        $dumpfile("alu.vcd");   // for waveform viewing
        $dumpvars(0, alu_4bit_tb);

      // Test ADD (op = 000)
        A = 4'b0011; B = 4'b0101; op = 3'b000;
        #10;
        $display("ADD: %b + %b = %b | zero=%b", A, B, result, zero);

      // Test SUB (op = 001)
        A = 4'b0111; B = 4'b0011; op = 3'b001;
        #10;
        $display("SUB: %b - %b = %b | zero=%b", A, B, result, zero);

      // Test AND (op = 010)
        A = 4'b1100; B = 4'b1010; op = 3'b010;
        #10;
        $display("AND: %b & %b = %b | zero=%b", A, B, result, zero);

      // Test OR (op = 011)
        A = 4'b1100; B = 4'b0011; op = 3'b011;
        #10;
        $display("OR:  %b | %b = %b | zero=%b", A, B, result, zero);
      
        // Test XOR (op = 100)
        A = 4'b1100; B = 4'b1010; op = 3'b100;
        #10;
      $display("XOR:  %b ^ %b = %b | zero=%b", A, B, result, zero);
      
      // Test left-shift (op = 101)
        A = 4'b0011; op = 3'b101;
        #10;
      $display("Left:  %b << 1 = %b | zero=%b", A, result, zero);
      
      // Test rightshift (op = 110)
        A = 4'b1100; op = 3'b110;
        #10;
      $display("right: %b >> 1 = %b | zero=%b", A, result, zero);
      
        // Test zero flag
        A = 4'b0000; B = 4'b0000; op = 3'b000;
        #10;
        $display("ZERO FLAG TEST: %b + %b = %b | zero=%b", A, B, result, zero);

        $finish;
    end

endmodule
